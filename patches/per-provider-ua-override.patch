 function requestHeaders(headers: Readonly<Record<string, string>> | undefined): Record<string, string> {
   const attribution = attributionHeaders()
+  const userEntries = Object.entries(headers ?? {})
+  // Check if the provider profile sets its own 'user-agent' (case-insensitive).
+  const hasUserUA = userEntries.some(([name]) => name.toLowerCase() === 'user-agent')
+  if (hasUserUA) {
+    // Per-provider UA wins: keep all user headers as-is (UA included).
+    return Object.fromEntries(userEntries)
+  }
+  // No per-provider UA: strip reserved names, then add attribution.
   const reserved = new Set(Object.keys(attribution).map(name => name.toLowerCase()))
   return {
-    ...Object.fromEntries(Object.entries(headers ?? {}).filter(([name]) => !reserved.has(name.toLowerCase()))),
+    ...Object.fromEntries(userEntries.filter(([name]) => !reserved.has(name.toLowerCase()))),
     ...attribution,
   }
 }
